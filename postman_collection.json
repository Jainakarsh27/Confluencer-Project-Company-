{
  "info": {
    "name": "LedgerFlow Transaction Ledger API",
    "_postman_id": "7b8d9e21-0a3f-42e7-91a1-301149e29a91",
    "description": "Comprehensive Postman test collection for LedgerFlow Transaction Ledger API covering all assessment cases, validation, edge cases, and reconciliation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Create Account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Initial balance is strictly 0.00', function () {",
              "    pm.expect(json.balance).to.eql('0.00');",
              "});",
              "pm.collectionVariables.set('accountId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Akarsh Jain\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts"]
        }
      }
    },
    {
      "name": "2. Get Account Balance (Initial)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "balance"]
        }
      }
    },
    {
      "name": "3. Add Credit Transaction (100.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Balance updated to 100.00', function () {",
              "    pm.expect(json.resulting_balance).to.eql('100.00');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": \"100.00\",\n  \"description\": \"Initial deposit\",\n  \"reference_id\": \"DEP-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "4. Add Debit Transaction (30.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Balance decremented to 70.00', function () {",
              "    pm.expect(json.resulting_balance).to.eql('70.00');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": \"30.00\",\n  \"description\": \"Book purchase\",\n  \"reference_id\": \"PUR-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "5. Debit Overdraft Rejection (150.00 against 70.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422 Unprocessable Content', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Error code is INSUFFICIENT_FUNDS', function () {",
              "    pm.expect(json.error.code).to.eql('INSUFFICIENT_FUNDS');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"debit\",\n  \"amount\": \"150.00\",\n  \"description\": \"Excessive purchase\",\n  \"reference_id\": \"PUR-EXCESS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "6. Duplicate Reference ID Rejection (DEP-001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Error code is DUPLICATE_TRANSACTION', function () {",
              "    pm.expect(json.error.code).to.eql('DUPLICATE_TRANSACTION');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"credit\",\n  \"amount\": \"100.00\",\n  \"description\": \"Duplicate attempt\",\n  \"reference_id\": \"DEP-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
        }
      }
    },
    {
      "name": "7. Get Transaction History (All)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "8. Filter Transactions (Credit Only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions?type=credit",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "type", "value": "credit" }
          ]
        }
      }
    },
    {
      "name": "9. Filter Transactions (Debit Only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions?type=debit",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "type", "value": "debit" }
          ]
        }
      }
    },
    {
      "name": "10. Run Balance Reconciliation Audit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Ledger is consistent', function () {",
              "    pm.expect(json.is_consistent).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/reconciliation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "accounts", "{{accountId}}", "reconciliation"]
        }
      }
    }
  ]
}
